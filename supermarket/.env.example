# העתיקו ל-.env ושנו ערכים לפי הצורך

# --- PostgreSQL ---
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- אפליקציה ---
WEB_PORT=3000
# מחיר שלא עודכן מעל מספר השעות הזה מסומן "ישן"
STALE_PRICE_HOURS=36

# --- טעינת נתונים (ingest) ---
# true = טעינת מחירים לכל הסניפים בארץ (כבד: מאות סניפים לרשת)
INGEST_ALL_STORES=false
# שלב 1: רשימת מספרי סניפים של שופרסל לטעינה (מופרדת בפסיקים) כש-INGEST_ALL_STORES=false.
# משלב 2 הבחירה תהיה לפי רדיוס סביב הכתובות השמורות.
SHUFERSAL_STORE_IDS=1,2,3
# השהיה בשניות בין בקשות לאותו אתר
REQUEST_DELAY_SECONDS=1
TZ=Asia/Jerusalem
