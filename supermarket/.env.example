# העתיקו ל-.env ושנו ערכים לפי הצורך

# --- PostgreSQL ---
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- אפליקציה ---
# סיסמה משפחתית אחת לכניסה (חובה). החלפה שלה מנתקת את כל המכשירים
FAMILY_PASSWORD=change-me-too
# אופציונלי: מפתח לחתימת עוגיית הכניסה (ברירת מחדל: נגזר מהסיסמה)
SESSION_SECRET=
WEB_PORT=3000
# כתובת ההאזנה של האפליקציה. בשרת עם Caddy (docker-compose.prod.yml): 127.0.0.1
WEB_BIND=0.0.0.0
# הדומיין של האפליקציה, ל-HTTPS בשרת (docker-compose.prod.yml)
APP_DOMAIN=
# מחיר שלא עודכן מעל מספר השעות הזה מסומן "ישן"
STALE_PRICE_HOURS=36

# רדיוס ברירת מחדל (ק"מ) לכתובת חדשה
DEFAULT_RADIUS_KM=5
# פיצול לשני סניפים מוצג רק כשהוא חוסך לפחות סכום זה (אפשר לשנות גם במסך ההגדרות)
SPLIT_MIN_SAVING=20

# --- הוספה מחשבונית ---
# מפתח API של Claude (console.anthropic.com). בלי מפתח, כפתור "הוספה מחשבונית" מציג הסבר ואינו פעיל.
# החשבונית נשלחת ל-Anthropic לזיהוי המוצרים; כל קריאה עולה כמה אגורות עד כמה עשרות אגורות.
ANTHROPIC_API_KEY=
# אופציונלי: מודל אחר לקריאת החשבונית (ברירת מחדל: claude-opus-5-5)
RECEIPT_MODEL=

# --- טעינת נתונים (ingest) ---
# שעת הריצה הלילית, שעון ישראל
NIGHTLY_TIME=06:00
# כמה ימים לשמור רישומי ריצות וקבצים (היסטוריית המחירים נשמרת תמיד)
RETENTION_DAYS=60
# false = מחירים רק לסניפים ברדיוס הכתובות השמורות. true = כל הסניפים בארץ (כבד מאוד)
INGEST_ALL_STORES=false
# השהיה בשניות בין בקשות לאותו אתר
REQUEST_DELAY_SECONDS=1
# geocoding: ברירת המחדל היא Nominatim של OpenStreetMap (עד בקשה אחת בשנייה)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=supermarket-basket-compare/0.2
GEOCODER_DELAY_SECONDS=1.5

# --- מעקב והתראות ---
# התראה על שינוי מחיר באחוזים האלה ומעלה
ALERT_CHANGE_PCT=10
# מייל יומי מרוכז. בלי SMTP_HOST ו-ALERT_EMAIL_TO לא נשלח מייל (ההתראות עדיין מופיעות באפליקציה)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# נמענים, מופרדים בפסיקים
ALERT_EMAIL_TO=
# כתובת האפליקציה, לקישור במייל
APP_URL=

TZ=Asia/Jerusalem
