# העתיקו ל-.env ושנו ערכים לפי הצורך

# --- PostgreSQL ---
POSTGRES_DB=supermarket
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- אפליקציה ---
# כניסה עם חשבון Google (חובה). יוצרים "OAuth client ID" מסוג Web application ב-console.cloud.google.com,
# עם Authorized redirect URI:  <APP_URL>/api/auth/google/callback   (ההסבר המלא ב-DEPLOY.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# הכתובת שבה גולשים לאפליקציה, בלי לוכסן בסוף. למשל https://sal.example.com (או http://localhost:3000 במחשב)
APP_URL=http://localhost:3000
# מפתח לחתימת עוגיית הכניסה: מחרוזת אקראית ארוכה. החלפה שלו מנתקת את כל המכשירים
# (ברירת מחדל: נגזר מ-GOOGLE_CLIENT_SECRET)
SESSION_SECRET=
# אופציונלי: רק כתובות המייל האלה יוכלו להיכנס (מופרדות בפסיק). ריק = כל חשבון Google
ALLOWED_EMAILS=
# מי רואה את מסך הניהול (משתמשים ושגיאות), מופרדות בפסיק. ריק = המשתמש הראשון שנרשם
ADMIN_EMAILS=
# כמה כתובות (אזורי חיפוש) כל משתמש יכול לשמור
MAX_ADDRESSES_PER_USER=3
WEB_PORT=3000
# כתובת ההאזנה של האפליקציה. בשרת עם Caddy (docker-compose.prod.yml): 127.0.0.1
WEB_BIND=0.0.0.0
# הדומיין של האפליקציה, ל-HTTPS בשרת (docker-compose.prod.yml)
APP_DOMAIN=
# מחיר שלא עודכן מעל מספר השעות הזה מסומן "ישן"
STALE_PRICE_HOURS=36

# רדיוס ברירת מחדל (ק"מ) לכתובת חדשה
DEFAULT_RADIUS_KM=5
# פיצול לשני סניפים מוצג רק כשהוא חוסך לפחות סכום זה (אפשר לשנות גם במסך ההגדרות)
SPLIT_MIN_SAVING=20

# --- טעינת נתונים (ingest) ---
# שעת הריצה הלילית, שעון ישראל
NIGHTLY_TIME=06:00
# כמה ימים לשמור רישומי ריצות וקבצים (היסטוריית המחירים נשמרת תמיד)
RETENTION_DAYS=60
# false = מחירים רק לסניפים ברדיוס הכתובות השמורות. true = כל הסניפים בארץ (כבד מאוד)
INGEST_ALL_STORES=false
# השהיה בשניות בין בקשות לאותו אתר
REQUEST_DELAY_SECONDS=1
# geocoding: ברירת המחדל היא Nominatim של OpenStreetMap (עד בקשה אחת בשנייה)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=supermarket-basket-compare/0.2
GEOCODER_DELAY_SECONDS=1.5

# --- מעקב והתראות ---
# התראה על שינוי מחיר באחוזים האלה ומעלה
ALERT_CHANGE_PCT=10
# מייל יומי מרוכז, לכל משתמש לכתובת ה-Gmail שלו. בלי SMTP_HOST לא נשלח מייל (ההתראות עדיין מופיעות באפליקציה)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

TZ=Asia/Jerusalem
